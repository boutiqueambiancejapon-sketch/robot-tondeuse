# Every night at 02:05 (Brussels; 01:05 UTC in winter): off the hours of the other night jobs (site-articles 23:37 UTC,
# tenmin-fiches 01:40 UTC, qrt-offres Monday 02:15 UTC, tenmin-seo-collect 03:30 UTC, toutou-seo-collect 04:10 UTC).
[Unit]
Description=Quel Robot Tondeuse - SEO dashboard collectors, every night

[Timer]
OnCalendar=*-*-* 02:05:00 Europe/Brussels
Persistent=true

[Install]
WantedBy=timers.target
