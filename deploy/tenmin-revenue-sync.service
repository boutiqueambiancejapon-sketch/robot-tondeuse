# 10minlanguages.com: real sales from the control centre into analytics.revenue_sales (Dashboard › Revenus).
# Install: sudo install -m 755 deploy/revenue-sync.sh /usr/local/sbin/tenmin-revenue-sync
#          && sudo cp deploy/tenmin-revenue-sync.* /etc/systemd/system/ && sudo systemctl daemon-reload
#          && sudo systemctl enable --now tenmin-revenue-sync.timer
# Safeguard: /etc/systemd/system/tenmin-revenue-sync.service.d/safeguard.conf puts it in background.slice.
[Unit]
Description=10minlanguages - real sales to the dashboard
After=postgresql.service

[Service]
Type=oneshot
User=administrator
Nice=15
ExecStart=/usr/bin/bash -euo pipefail /usr/local/sbin/tenmin-revenue-sync
